# --- Firebase (client, pubbliche) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Email admin separate da virgola (devono coincidere con firestore.rules / storage.rules)
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Firebase Admin (server, segrete) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Email prenotazioni (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=prenotazioni@pizzeriaduecentogrammi.it
OWNER_EMAIL=prenotazioni@pizzeriaduecentogrammi.it
# Firma dei link "accetta/rifiuta proposta" nelle email
RESERVATION_ACTION_SECRET=

# --- Anti-spam prenotazioni (Cloudflare Turnstile) ---
# Se vuote, la casella non compare e il server non verifica.
# Chiavi di test Cloudflare (passano sempre): 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Traduzione automatica del menu (Claude API) ---
ANTHROPIC_API_KEY=
